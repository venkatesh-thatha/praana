# Atlas SRV URI — replace cluster0.xxxxx with your real hostname from Atlas → Connect → Drivers
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/praana?retryWrites=true&w=majority
MONGODB_DB_NAME=praana
JWT_SECRET=change-this-to-a-long-random-string-minimum-32-chars
ANTHROPIC_API_KEY=sk-ant-api03-...
ICD11_CLIENT_ID=your-icd11-client-id
ICD11_CLIENT_SECRET=your-icd11-client-secret
OPENFDA_API_KEY=
OPENAQ_API_KEY=
FRONTEND_URL=http://localhost:5173
